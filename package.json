{
  "name": "dsh-balance-bar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: shows the DeepSeek account balance in the sidebar foot and opens the Platform usage page in-app.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Balance bar",
    "description": "Shows the account balance above the sidebar account row; click it to open usage."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
